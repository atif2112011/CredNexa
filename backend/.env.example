NODE_ENV=development
APP_PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/emi_shield
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
CRON_SECRET=replace-with-shared-cron-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX_REQUESTS=5
OTP_PROVIDER=mock
OTP_EXPIRES_IN_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=30
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_DEFAULT_COUNTRY_CODE=91
MSG91_RESEND_RETRY_TYPE=text
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DEVICE_INTEGRITY_MODE=observe
PLAY_INTEGRITY_PACKAGE_NAME=com.crednexa.app
PLAY_INTEGRITY_CHALLENGE_TTL_SECONDS=600
PLAY_INTEGRITY_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
PLAY_INTEGRITY_REQUIRE_PLAY_RECOGNIZED_APP=false
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
ADMIN_FIREBASE_PROJECT_ID=
ADMIN_FIREBASE_CLIENT_EMAIL=
ADMIN_FIREBASE_PRIVATE_KEY=
APP_FIREBASE_API_KEY=
APP_FIREBASE_AUTH_DOMAIN=
APP_FIREBASE_PROJECT_ID=
APP_FIREBASE_STORAGE_BUCKET=
APP_FIREBASE_MESSAGING_SENDER_ID=
APP_FIREBASE_APP_ID=
APP_FIREBASE_MEASUREMENT_ID=
DIRECT_UPLOAD_ALLOWED_ORIGINS=http://localhost:3000

MANUAL_OVERRIDE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
MANUAL_OVERRIDE_PUBLIC_KEY_ID=manual-override-v1
MANUAL_OVERRIDE_SIGNING_ALGORITHM=RS256
MANUAL_OVERRIDE_TOKEN_VALIDITY_DAYS=30
MANUAL_OVERRIDE_RENEWAL_WINDOW_DAYS=7
MANUAL_OVERRIDE_ALLOW_INSECURE_KEY_SIZE=false
