NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/emi_shield
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
VERCEL=false
OTP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY_CODE=+91
DEVICE_INTEGRITY_MODE=observe
PLAY_INTEGRITY_PACKAGE_NAME=com.crednexa.app
PLAY_INTEGRITY_CHALLENGE_TTL_SECONDS=600
PLAY_INTEGRITY_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
PLAY_INTEGRITY_REQUIRE_PLAY_RECOGNIZED_APP=false
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
